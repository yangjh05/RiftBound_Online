# `npm run server:restart`가 출력한 Tailscale Funnel 공개 주소입니다.
# 브라우저 플레이만 할 때는 비워 두어도 되며, 데스크톱 앱 업데이트를 빌드할 때 사용됩니다.
RIFTBOUND_UPDATE_URL=https://punchfirst.site
RIFTBOUND_MULTIPLAYER_URL=https://punchfirst.site
## Optional: point the game server at a separate AI training workspace.
# RIFTBOUND_AI_DATA_DIR=C:\path\to\training-workspace\data\ai

## Optional: account and account-owned deck database location.
## Defaults to data/accounts.json. The packaged desktop app uses its user-data folder.
# RIFTBOUND_ACCOUNT_DATA_FILE=C:\path\to\private-data\accounts.json

## Optional: submitted game reproduction logs and protected administrator API.
## Reports default to data/bug-reports. Use a long, random administrator token.
# RIFTBOUND_BUG_REPORT_DATA_DIR=C:\path\to\private-data\bug-reports
# RIFTBOUND_BUG_REPORT_ADMIN_TOKEN=replace-with-a-long-random-secret
## New reports are rejected with HTTP 507 when either quota is full. Existing reports are kept.
# RIFTBOUND_BUG_REPORT_MAX_COUNT=1000
# RIFTBOUND_BUG_REPORT_MAX_TOTAL_BYTES=2147483648
## Explicit opt-in: delete the oldest reports as needed instead of rejecting a new report.
# RIFTBOUND_BUG_REPORT_PRUNE_ON_QUOTA=false
## Bounds the in-memory per-address limiter. Forwarded addresses are ignored by default.
# RIFTBOUND_BUG_REPORT_RATE_LIMIT_MAX_ENTRIES=2048
## Enable only for a trusted loopback proxy. Funnel restarts enable it in-process when unset.
# RIFTBOUND_BUG_REPORT_TRUST_PROXY=false

## Optional: Telegram notifications for `npm run ai:progress:telegram`.
# RIFTBOUND_TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# RIFTBOUND_TELEGRAM_CHAT_ID=123456789

## Optional: offload deterministic evaluator seed batches to one Lightsail host.
## The local coordinator remains the only owner of the evaluator dataset.
# RIFTBOUND_ACTION_AUDIT_REMOTE_HOST=riftbound-lightsail
# RIFTBOUND_ACTION_AUDIT_REMOTE_PROJECT_ROOT=/home/ubuntu/riftbound-audit/current
# RIFTBOUND_ACTION_AUDIT_REMOTE_RUNTIME_ROOT=/home/ubuntu/riftbound-audit/runtime
# RIFTBOUND_ACTION_AUDIT_REMOTE_IDENTITY_FILE=C:\path\to\LightsailDefaultKey.pem
# RIFTBOUND_ACTION_AUDIT_REMOTE_PORT=22
# RIFTBOUND_ACTION_AUDIT_REMOTE_MAX_WORKERS=2
# RIFTBOUND_ACTION_AUDIT_REMOTE_MINIMUM_FREE_MEMORY_MB=250
# RIFTBOUND_ACTION_AUDIT_REMOTE_WORKER_HEADROOM_MB=256
# RIFTBOUND_ACTION_AUDIT_REMOTE_NODE_HEAP_MB=384
# RIFTBOUND_ACTION_AUDIT_REMOTE_CANDIDATE_CACHE_MB=2048
# RIFTBOUND_ACTION_AUDIT_REMOTE_TRANSFER_TIMEOUT_SECONDS=600
# RIFTBOUND_ACTION_AUDIT_REMOTE_REQUEST_TIMEOUT_MINUTES=360
# RIFTBOUND_ACTION_AUDIT_REMOTE_SESSION_TTL_HOURS=24
# The coordinator also loads these values automatically from the ignored
# `.env.action-audit-remote` file written by the Lightsail deploy script.
