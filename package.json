{
  "name": "riftbound-online",
  "version": "0.1.0",
  "private": true,
  "riftboundUpdateBaseUrl": "https://punchfirst.site",
  "riftboundMultiplayerBaseUrl": "https://punchfirst.site",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "train:deck-league": "powershell -NoProfile -File scripts/run-deck-league.ps1",
    "test:deck-league": "node --test tests/deck-league.test.mjs tests/deck-league-routing.test.mjs",
    "train:adaptive": "node --require ./scripts/ai-training-priority.cjs --require ./scripts/tf-node-compat.cjs --expose-gc --max-old-space-size=8192 scripts/train-adaptive-policy-q.mjs",
    "ai:dashboard": "node scripts/ai-dashboard.mjs",
    "ai:storage": "node scripts/training-storage-maintenance.mjs",
    "ai:storage:clean": "node scripts/training-storage-maintenance.mjs --apply",
    "ai:storage:watch": "node scripts/training-storage-maintenance.mjs --apply --watch",
    "build:mobile": "vite build --config vite.mobile.config.mjs",
    "preview:mobile": "vite preview --config vite.mobile.config.mjs",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:apk": "npm run android:sync && node scripts/build-android.mjs",
    "dist:win": "node scripts/build-win.mjs",
    "publish:update": "npm run dist:win",
    "update:keygen": "node scripts/generate-update-key.mjs",
    "desktop": "node scripts/run-desktop.mjs",
    "desktop:setup": "npm install --prefix .desktop_runtime electron@41.7.1",
    "audit:effects": "node scripts/audit-effects.mjs",
    "audit:set": "node scripts/audit-card-set-intake.mjs",
    "export:cards": "node scripts/export-card-data.mjs",
    "import:cards": "node scripts/import-cards.mjs",
    "new:card": "node scripts/new-card.mjs",
    "validate:cards": "node scripts/validate-cards.mjs",
    "validate:engine": "node scripts/validate-engine-effects.mjs",
    "validate:rules": "node scripts/validate-rule-contracts.mjs && node scripts/build-effect-rule-map.mjs",
    "validate:training-safety": "node scripts/validate-training-safety.mjs",
    "judge:rules": "node scripts/run-rule-oracle-audit.mjs",
    "refresh:official-cards": "node scripts/refresh-official-card-gallery.mjs",
    "refresh:set-source": "node scripts/refresh-card-set-source.mjs --output spec/cards/spiritforged-official-2026-08-29.json",
    "build:spiritforged": "node scripts/build-spiritforged-cards.mjs",
    "build:unleashed": "node scripts/build-unleashed-cards.mjs",
    "judge:cards": "node scripts/card-rules-judge.mjs",
    "judge:cards:update": "node scripts/card-rules-judge.mjs --update-contracts",
    "judge:coverage:update": "node scripts/card-rules-judge.mjs --update-coverage",
    "judge:architecture:update": "node scripts/card-rules-judge.mjs --update-architecture",
    "audit:ko": "node scripts/audit-korean-terms.mjs",
    "audit:card-logic": "node scripts/audit-card-logic.mjs --strict",
    "check": "npm run validate:cards && npm run validate:engine && npm run validate:rules && npm run judge:rules && npm run judge:cards && npm run audit:ko && npm run audit:card-logic && npm run validate:training-safety && npm run validate:paired-action-effect-coverage && npm test && npm run test:e2e && npm run test:mutations && npm run test:effect-mutations && npm run interactions && npm run check:dynamic",
    "check:no-ai": "npm run validate:cards && npm run validate:engine && npm run validate:rules && npm run judge:rules && npm run judge:cards && npm run audit:ko && npm run audit:card-logic && npm run test:non-ai && npm run test:e2e:non-ai && npm run test:mutations && npm run test:effect-mutations && npm run interactions && npm run check:dynamic",
    "validate:paired-action-effect-coverage": "node scripts/validate-paired-action-effect-coverage.mjs",
    "check:dynamic": "node scripts/fuzz-games.mjs --games 50 --max-actions 140 --seed 20260714 && node scripts/scenario-games.mjs --scenarios 32 --max-actions 180 --seed 20260714",
    "start": "node scripts/dev-server.mjs",
    "restart": "npm run publish:update && node scripts/restart-server.mjs",
    "restart:local": "node scripts/server-control.mjs restart --no-tunnel",
    "stop": "node scripts/stop-server.mjs",
    "server:restart": "node scripts/restart-server.mjs",
    "server:stop": "node scripts/stop-server.mjs",
    "bug-reports": "node scripts/bug-reports.mjs",
    "ai:live-game": "node --require ./scripts/ai-training-priority.cjs --require ./scripts/tf-node-compat.cjs scripts/live-game-curriculum.mjs",
    "test": "node --test tests",
    "test:non-ai": "node scripts/run-non-ai-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:tabletop": "playwright test e2e/tabletop-ui-regression.spec.mjs e2e/tabletop-motion-regression.spec.mjs",
    "test:ui:tabletop": "node --test tests/tabletop-view.test.mjs tests/tabletop-motion.test.mjs && npm run test:e2e:tabletop",
    "test:e2e:non-ai": "playwright test --grep-invert \"(^|[^A-Za-z])AI([^A-Za-z]|$)\"",
    "test:e2e:install": "playwright install chromium",
    "fuzz": "node scripts/fuzz-games.mjs",
    "scenarios": "node scripts/scenario-games.mjs",
    "interactions": "node scripts/interaction-scenarios.mjs",
    "test:mutations": "node scripts/run-regression-mutants.mjs",
    "test:effect-mutations": "node scripts/run-effect-mutants.mjs",
    "test:effect-mutations:update": "node scripts/run-effect-mutants.mjs --update-baseline",
    "ai:train": "node --require ./scripts/ai-training-priority.cjs scripts/train-ai.mjs",
    "ai:train:quick": "node --require ./scripts/ai-training-priority.cjs scripts/train-ai.mjs --games 10 --evaluation-games 4 --max-actions 240",
    "ai:neural:train": "node --require ./scripts/ai-training-priority.cjs scripts/train-neural-ai.mjs",
    "ai:progress": "node scripts/watch-ai-progress.mjs",
    "ai:progress:telegram": "node --env-file=.env scripts/watch-ai-progress.mjs --telegram true --skip-initial-telegram true",
    "ai:neural:smoke": "node --require ./scripts/ai-training-priority.cjs scripts/train-neural-ai.mjs --games 2 --evaluation-games 2 --workers 1 --epochs 1 --max-actions 120",
    "ai:failure:verify": "node scripts/verify-ai-failure.mjs",
    "ai:payment:verify": "node --test --test-name-pattern=\"AI payment planner\" tests/engine.test.mjs",
    "ai:continuous": "node --require ./scripts/ai-training-priority.cjs scripts/train-neural-ai.mjs --continuous true --games 64 --evaluation-games 40 --workers 4",
    "ai:meta:import": "node scripts/import-ai-meta.mjs",
    "ai:bootstrap": "node --require ./scripts/ai-training-priority.cjs scripts/bootstrap-neural-ai.mjs",
    "ai:bootstrap:logged": "node --require ./scripts/ai-training-priority.cjs scripts/run-bootstrap-ai.mjs",
    "ai:bootstrap:apply": "node scripts/apply-ai-bootstrap-artifact.mjs",
    "ai:collect:shard": "node --require ./scripts/ai-training-priority.cjs scripts/collect-ai-shard.mjs",
    "ai:audit:deploy:lightsail": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-lightsail-action-audit-worker.ps1",
    "ai:audit:verify:lightsail": "node scripts/verify-lightsail-action-audit-worker.mjs"
  },
  "build": {
    "appId": "com.riftbound.online",
    "productName": "Riftbound Online",
    "directories": {
      "output": "dist"
    },
    "files": [
      "assets/**",
      "electron/**",
      "build-info.json",
      "index.html",
      "server/**",
      "scripts/file-replace.mjs",
      "src/**",
      "!src/.mutant-*.mjs",
      "!src/**/.mutant-*.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "server/**",
      "scripts/file-replace.mjs",
      "src/**"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Riftbound Online.exe"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@playwright/test": "^1.61.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.0.12",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0"
  }
}
